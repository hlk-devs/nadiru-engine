# Nadiru Engine Configuration
# Copy this file to .env and customize.

# Which provider runs the Conductor (routing decisions)?
# Options: "ollama" (local), "anthropic", "openai", "google", or any provider name in registry.
# Default: "ollama"
CONDUCTOR_PROVIDER=ollama

# Which model from that provider should route requests?
# Examples:
#   ollama: qwen2.5:14b
#   anthropic: claude-haiku-4-5-20251001
#   openai: gpt-4o-mini
#   google: gemini-2.5-flash
CONDUCTOR_MODEL=qwen2.5:14b

# Local backend URL (used when CONDUCTOR_PROVIDER=ollama)
LOCAL_MODEL_URL=http://localhost:11434

# Tier 1 (recommended): Cloud Conductor
# CONDUCTOR_PROVIDER=google
# CONDUCTOR_MODEL=gemini-2.5-flash

# Tier 2: Beefy local Conductor
# CONDUCTOR_PROVIDER=ollama
# CONDUCTOR_MODEL=llama3.1:70b

# Tier 3: Small local Conductor (delegate-first warmup)
# CONDUCTOR_PROVIDER=ollama
# CONDUCTOR_MODEL=qwen2.5:14b

ENGINE_PORT=8765
ENGINE_HOST=0.0.0.0
# NADIRU_DB_PATH=nadiru.db

# =============================================================================
# Provider API keys (set only what you use; engine loads providers when non-empty)
# =============================================================================
#
# | Provider        | Required env var(s)                          |
# |-----------------|-----------------------------------------------|
# | Ollama          | (none — local; use LOCAL_MODEL_URL above)     |
# | Anthropic       | ANTHROPIC_API_KEY                             |
# | OpenAI          | OPENAI_API_KEY                                |
# | Google          | GOOGLE_API_KEY                                |
# | Groq            | GROQ_API_KEY                                    |
# | DeepSeek        | DEEPSEEK_API_KEY                              |
# | Together        | TOGETHER_API_KEY                              |
# | Perplexity      | PERPLEXITY_API_KEY                            |
# | Cerebras        | CEREBRAS_API_KEY                              |
# | OpenRouter      | OPENROUTER_API_KEY                            |
# | Mistral         | MISTRAL_API_KEY                               |
# | Fireworks       | FIREWORKS_API_KEY                             |
# | AI21            | AI21_API_KEY                                  |
# | Cohere          | COHERE_API_KEY                                |
# | Azure OpenAI    | AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT  |
#
# Any OpenAI-compatible API: add PROVIDER_MAP entry in registry.py + env var.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GOOGLE_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# TOGETHER_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# CEREBRAS_API_KEY=csk-...
# OPENROUTER_API_KEY=sk-or-...
# MISTRAL_API_KEY=...
# FIREWORKS_API_KEY=...
# AI21_API_KEY=...
# COHERE_API_KEY=...
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
